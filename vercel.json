{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": null,
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "firekirin.games"
        }
      ],
      "destination": "https://www.firekirin.games/$1",
      "permanent": true
    }
  ]
}
